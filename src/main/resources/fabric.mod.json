	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"gridworks": ">=1.1.2",
		"radiation": ">=1.4.0",
		"hamradio": ">=1.6.0",
		"fission": ">=1.1.0"
